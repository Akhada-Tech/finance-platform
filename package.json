{
  "name": "finance-platform",
  "private": true,
  "version": "0.0.0",
  "description": "Offline-first personal finance platform for Indian users",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "turbo run start",
    "android": "pnpm --filter @finance-platform/mobile android",
    "ios": "pnpm --filter @finance-platform/mobile ios",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.4"
  }
}
